{
  "rules": {
    "games": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4}$/)",
        ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
        "host": { ".write": "auth != null && $code.matches(/^[A-Z0-9]{4}$/) && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid" },
        "t":    { ".write": "auth != null && root.child('games/' + $code + '/host').val() === auth.uid" },
        "st":   { ".write": "auth != null && root.child('games/' + $code + '/host').val() === auth.uid",
                  ".validate": "newData.isString() && newData.val().length < 6000" },
        "p": {
          "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('games/' + $code + '/host').exists()",
                    ".validate": "newData.isString() && newData.val().length < 400" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
