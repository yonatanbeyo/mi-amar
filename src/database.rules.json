{
  "rules": {
    "games": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4}$/)",
        ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
        "host": {
          ".write": "auth != null && $code.matches(/^[A-Z0-9]{4}$/) && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid"
        },
        "t": {
          ".write": "auth != null && root.child('games/' + $code + '/host').val() === auth.uid"
        },
        "st": {
          ".write": "auth != null && root.child('games/' + $code + '/host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length < 6000"
        },
        "p": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games/' + $code + '/host').exists()",
            ".validate": "newData.isString() && newData.val().length < 400"
          }
        },
        "x": {
          "$to": {
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.child('f').val() === auth.uid && root.child('games/' + $code + '/host').exists()) || (auth.uid === $to && !newData.exists()))",
              ".validate": "newData.hasChildren(['f','d']) && newData.child('f').isString() && newData.child('d').isString() && newData.child('d').val().length < 20000"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": true,
      "total": {
        "$key": {
          ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "days": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$key": {
            ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      }
    },
    "live": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['s','n','t']) && newData.child('s').isString() && newData.child('s').val().length < 12 && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 30 && newData.child('t').val() <= now + 60000",
        "$other": {
          ".validate": "$other === 's' || $other === 'n' || $other === 't'"
        }
      }
    },
    "pay": {
      ".read": "auth != null && auth.token.email === 'yonatan.beyo@gmail.com' && auth.token.email_verified === true",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('s').val() === 'wait') || (auth != null && auth.token.email === 'yonatan.beyo@gmail.com' && auth.token.email_verified === true))",
        ".validate": "$code.matches(/^[0-9]{6}$/) && newData.hasChildren(['c','s','t'])",
        "c": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{20}$/)"
        },
        "s": {
          ".validate": "newData.val() === 'wait' || newData.val() === 'ok' || newData.val() === 'no'"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "a": {
          ".validate": "newData.isNumber()"
        },
        "r": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "unlocks": {
      "$key": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'yonatan.beyo@gmail.com' && auth.token.email_verified === true",
        ".validate": "$key.matches(/^[0-9a-f]{20}$/) && newData.hasChildren(['code','t'])"
      }
    }
  }
}